/**
 * GET /api/<WS>/<PLUGIN>/{{FEATURE}}/read
 *
 * Reads the file at `{{TARGET_FILE}}` (relative to workspaceDir) and returns
 * its UTF-8 content. Used by a textarea-edit-multi-section view in
 * manage.yaml. The view sends GET, expects { content: string }.
 *
 * Factory pattern: the caller resolves workspaceDir once at plugin-entry
 * time (via `api.runtime.agent.resolveAgentWorkspaceDir(api.config)` or the
 * plugin's existing convention) and passes it in. Avoids module-level
 * singletons that break on re-bootstrap.
 *
 * Generated by the edit-agent-dashboard skill (Case C).
 * Bundle re-install will overwrite this file.
 */

import { promises as fs } from "node:fs";
import type { IncomingMessage, ServerResponse } from "node:http";
import { safeWorkspacePath } from "../workspace-files.js"; // ← adjust if helper lives elsewhere
import { sendError, sendJson } from "./http.js";

const TARGET_FILE = "{{TARGET_FILE}}";

export function make{{HANDLER_NAME_READ}}(workspaceDir: string) {
  return async function {{HANDLER_NAME_READ}}(
    _req: IncomingMessage,
    res: ServerResponse,
  ): Promise<void> {
    let abs: string;
    try {
      abs = safeWorkspacePath(workspaceDir, TARGET_FILE);
    } catch (e) {
      return sendError(res, 400, "invalid_path", (e as Error).message);
    }
    let content = "";
    try {
      content = await fs.readFile(abs, "utf8");
    } catch (e) {
      // File missing on first read is expected — return empty content.
      // Any other error is a real failure.
      if ((e as NodeJS.ErrnoException).code !== "ENOENT") {
        return sendError(res, 500, "read_failed", (e as Error).message);
      }
    }
    sendJson(res, 200, { content });
  };
}
