/**
 * POST /api/<WS>/<PLUGIN>/{{FEATURE}}/write
 *
 * Overwrites the file at `{{TARGET_FILE}}` (relative to workspaceDir) with
 * the `content` field of the JSON body. Used by a textarea-edit-multi-section
 * view in manage.yaml. The view sends POST { content: string }.
 *
 * Factory pattern: the caller resolves workspaceDir once at plugin-entry
 * time (via `api.runtime.agent.resolveAgentWorkspaceDir(api.config)` or the
 * plugin's existing convention) and passes it in.
 *
 * Generated by the edit-agent-dashboard skill (Case C).
 * Bundle re-install will overwrite this file.
 */

import { promises as fs } from "node:fs";
import path from "node:path";
import type { IncomingMessage, ServerResponse } from "node:http";
import { safeWorkspacePath } from "../workspace-files.js"; // ← adjust if helper lives elsewhere
import { readJsonBody, sendError, sendJson } from "./http.js";

const TARGET_FILE = "{{TARGET_FILE}}";

export function make{{HANDLER_NAME_WRITE}}(workspaceDir: string) {
  return async function {{HANDLER_NAME_WRITE}}(
    req: IncomingMessage,
    res: ServerResponse,
  ): Promise<void> {
    if (req.method !== "POST") {
      return sendError(res, 405, "method_not_allowed", "Use POST.");
    }
    let body: Record<string, unknown>;
    try {
      body = await readJsonBody(req);
    } catch (e) {
      return sendError(
        res,
        400,
        "invalid_body",
        `JSON body không hợp lệ: ${(e as Error).message}`,
      );
    }
    if (typeof body.content !== "string") {
      return sendError(
        res,
        400,
        "content_required",
        "Trường 'content' phải là string.",
      );
    }
    let abs: string;
    try {
      abs = safeWorkspacePath(workspaceDir, TARGET_FILE);
    } catch (e) {
      return sendError(res, 400, "invalid_path", (e as Error).message);
    }
    try {
      await fs.mkdir(path.dirname(abs), { recursive: true });
      await fs.writeFile(abs, body.content, "utf8");
    } catch (e) {
      return sendError(res, 500, "write_failed", (e as Error).message);
    }
    sendJson(res, 200, {
      ok: true,
      bytes: Buffer.byteLength(body.content, "utf8"),
    });
  };
}
